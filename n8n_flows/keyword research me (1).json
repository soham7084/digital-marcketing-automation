      "name": "Autocomplete"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of items) {\n  const raw = item.json.data;\n\n  // Parse the JSON string into a real array\n  let res;\n  if (typeof raw === 'string') {\n    res = JSON.parse(raw);\n  } else {\n    res = raw || [];\n  }\n\n  // Google Suggest: [query, [suggestions...], ...]\n  const suggestions = (Array.isArray(res) && Array.isArray(res[1])) ? res[1] : [];\n\n  for (const s of suggestions) {\n    out.push({\n      json: {\n        keyword: s\n      }\n    });\n  }\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        128
      ],
      "id": "0a593c40-0c2c-4974-bc94-01200404be5d",
      "name": "Flatten Suggestions"
    },
    {
      "parameters": {
        "jsCode": "// Collect ALL items from Flatten Suggestions (across all batches)\nconst allItems = $items('Flatten Suggestions');\n\nconst map = {};\n\nfor (const i of allItems) {\n  const kw = (i.json.keyword || '').trim();\n  if (!kw) continue;\n  const key = kw.toLowerCase();\n  map[key] = kw;\n}\n\n// Return unique keywords as items\nreturn Object.values(map).map(kw => ({\n  json: { keyword: kw }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
