      "id": "2ce79469-a1d1-4f25-9464-d3c74f35bc10",
      "name": "Webhook",
      "webhookId": "95d08a58-c716-4dba-89c7-29a63d50ab7b"
    },
    {
      "parameters": {
        "jsCode": "// Get the first item coming from the Webhook\n// In your case, the real payload is under json.body\nconst request = items[0].json;\nconst body = request.body || {}; // fallback in case body is missing\n\n// Convert comma-separated seeds into an array\nconst seeds = (body.seeds || body.topic || '')\n  .split(',')\n  .map(k => k.trim())\n  .filter(Boolean);\n\n// Return one item with normalized fields\nreturn [\n  {\n    json: {\n      topic: body.topic || seeds[0] || '',\n      seeds,\n      country_code: body.country_code || 'US',\n      language_code: body.language_code || 'en'\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        16
      ],
      "id": "5e4bd2a7-8a62-414f-b8e6-d79f0e3e7df3",
      "name": "Parse Input"
    },
    {
      "parameters": {
        "jsCode": "// Input: one item from Parse Input with json = { topic, seeds[], country_code, language_code }\nconst input = items[0].json;\n\n// 1) Take the seeds array; if empty, fall back to topic\nconst seeds = (input.seeds && input.seeds.length > 0)\n  ? input.seeds\n  : [input.topic].filter(Boolean);\n\n// 2) List of letters and common modifiers\nconst letters = 'abcdefghijklmnopqrstuvwxyz'.split('');\nconst modifiers = ['how to', 'best', 'vs', 'for', 'near me'];\n\n// 3) Generate queries\nconst queries = [];\n\n// basic seed itself\nfor (const seed of seeds) {\n  // plain seed\n  queries.push(seed);\n\n  // seed + A–Z\n  for (const l of letters) {\n    queries.push(`${seed} ${l}`);\n  }\n\n  // seed + modifiers\n  for (const m of modifiers) {\n    queries.push(`${seed} ${m}`);\n  }\n}\n\n// 4) Turn into n8n items\nreturn queries.map(q => ({\n  json: {\n    query: q,\n    // keep language / country if you want later\n    country_code: input.country_code,\n    language_code: input.language_code\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        16
      ],
      "id": "67d828d4-5075-4737-807b-b57ab0ede25e",
